# Copy this file to clinic.env in the clinic install folder (beside docker-compose.yml).
# Do not share the completed file: it contains database and login secrets.

# Fixed LAN address of the Ubuntu clinic machine.
SITE_HOST=192.168.1.50
NODE_ENV=production
PORT=3000
TZ=Asia/Colombo
COOKIE_SECURE=false

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL runs on this machine as the `db` service in docker-compose.yml. It is reachable only
# from the application over the private compose network, never from the clinic LAN.
#
# Set POSTGRES_PASSWORD to a long random value and put THE SAME value in both URLs below.
# Generate one with:  openssl rand -hex 24
# If the password contains characters other than letters and digits, URL-encode them in the URLs.
POSTGRES_DB=epoch
POSTGRES_USER=epoch
POSTGRES_PASSWORD=CHANGE_ME_run_openssl_rand_hex_24

# Host is the compose service name `db`, not localhost — the app runs in its own container.
DATABASE_URL=postgresql://epoch:CHANGE_ME_run_openssl_rand_hex_24@db:5432/epoch?connection_limit=10
DIRECT_URL=postgresql://epoch:CHANGE_ME_run_openssl_rand_hex_24@db:5432/epoch

# The startup security check looks for Supabase's public API roles (anon / authenticated) and is
# meaningless on a plain PostgreSQL where they do not exist. Leave this true for a local database.
SKIP_DB_SECURITY_CHECK=true

# Generate once with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_run_openssl_rand_base64_48

# ICD-11 diagnosis search needs nothing here: it is served by the local icd-api service in
# docker-compose.yml, with no internet and no WHO account.

# Logging and optional email alerts.
APP_VERSION=1.0.0
SERVICE_NAME=epoch-backend
LOG_LEVEL=info
ERROR_ALERT_EMAIL=
ERROR_ALERT_FROM="E-POCH Error Monitor <no-reply@epoch.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ERROR_ALERT_WINDOW_MS=600000
ERROR_ALERT_MAX_PER_HOUR=20

# ── Backups (backup.sh, run daily by epoch-backup.timer) ──────────────────────────
# REQUIRED before real patient data: a directory on a DIFFERENT drive than this machine's disk.
BACKUP_DEST=
BACKUP_RETENTION_DAYS=30
# A file holding a passphrase; backups are then encrypted (they contain patient records).
BACKUP_PASSPHRASE_FILE=
# Optional dead-man's-switch URL, pinged after each successful backup.
BACKUP_HEARTBEAT_URL=

# ── Monitoring (heartbeat.sh, run every 5 minutes by epoch-heartbeat.timer) ────────
# Optional healthchecks.io ping URL; pinged only while the app is healthy and the disk has room.
HEARTBEAT_URL=

# ── AI features (Pro, optional) ────────────────────────────────────────────────
# The AI pre-consultation summary for doctors. Off unless BOTH are set. When on, a de-identified
# extract of the patient's record (no name, NIC, phone or birth date; doctors' notes as written) is
# sent to Anthropic's API over the internet. Get a key at https://console.anthropic.com.
AI_FEATURES_ENABLED=false
ANTHROPIC_API_KEY=
# Optional: send AI requests through a relay instead of directly to Anthropic.
# ANTHROPIC_BASE_URL=
