# One-container clinic image: API, migrations, document rendering and the E-POCH web application.
# Build from the repository root:
#   docker build -f Dockerfile.clinic -t epoch-medical:clinic .
#
# Layer order matters for updates. The clinic receives only the layers it does not already have
# (see deploy/push-update.sh), so everything that rarely changes comes first and the application
# code — the only thing most releases touch — comes last, in small layers of its own.

FROM node:24-alpine AS backend-deps
WORKDIR /build/backend
RUN apk add --no-cache openssl
COPY backend/package*.json ./
RUN npm ci

# The generated database client depends only on the schema and the installed packages. Built in
# its own stage, it is reused from cache — byte for byte — until the schema actually changes.
FROM backend-deps AS prisma-client
COPY backend/prisma/schema.prisma ./prisma/schema.prisma
RUN npx prisma generate

FROM backend-deps AS backend-builder
COPY backend ./
RUN npx prisma generate && npm run build

FROM node:24-alpine AS frontend-builder
WORKDIR /build/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend ./
RUN npm run build

FROM node:24-alpine
WORKDIR /usr/src/app

# nginx serves the web application. The remaining packages support Prisma, health checks,
# encrypted backups, the clinic timezone, and Word-to-PDF letter rendering.
RUN apk add --no-cache \
      nginx openssl wget su-exec tzdata tar postgresql17-client \
      libreoffice-writer font-liberation font-carlito font-dejavu font-noto-sinhala font-noto-tamil \
    && fc-cache -f

ENV NODE_ENV=production \
    TZ=Asia/Colombo

# The app runs as appuser and only ever writes to uploads/, backups/ and logs/ (handed to appuser
# again at every start by the entrypoint, since they are bind-mounted from the host) and the temp
# directory. The code itself stays root-owned and read-only to it — a recursive chown here would
# also rewrite every application file into one large new layer on every build.
COPY deploy/clinic-nginx.conf /etc/nginx/http.d/default.conf
COPY backend/docker-entrypoint.sh /usr/local/bin/backend-entrypoint
COPY deploy/clinic-entrypoint.sh /usr/local/bin/clinic-entrypoint
RUN chmod +x /usr/local/bin/backend-entrypoint /usr/local/bin/clinic-entrypoint \
    && addgroup -S appgroup && adduser -S appuser -G appgroup \
    && mkdir -p uploads backups logs /run/nginx \
    && chown appuser:appgroup uploads backups logs \
    && nginx -t

# Changes only when dependencies change.
COPY backend/package*.json ./
RUN npm ci --omit=dev

# Changes only when the database schema changes.
COPY --from=prisma-client /build/backend/node_modules/.prisma ./node_modules/.prisma
COPY --from=prisma-client /build/backend/node_modules/@prisma ./node_modules/@prisma
COPY backend/prisma ./prisma
COPY backend/scripts/check-db-security.js backend/scripts/bootstrap-production.js ./scripts/

# Changes with every release — a few megabytes in total.
COPY --from=backend-builder /build/backend/dist ./dist
COPY --from=frontend-builder /build/frontend/dist /srv/epoch/app

EXPOSE 3000 5173
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget -q -O - http://127.0.0.1:3000/health >/dev/null \
      && wget -q -O - http://127.0.0.1:5173/health >/dev/null \
      || exit 1

ENTRYPOINT ["clinic-entrypoint"]
CMD ["node", "dist/server.js"]
